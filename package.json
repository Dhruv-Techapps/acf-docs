{
  "name": "acf-docs",
  "version": "1.0.0",
  "description": "Auto Clicker - AutoFill documentation site",
  "scripts": {
    "start": "npm run docs-serve",
    "docs": "npm-run-all docs-build docs-lint",
    "docs-build": "npm run astro-build",
    "docs-compile": "npm run docs-build",
    "docs-vnu": "node build/vnu-jar.mjs",
    "docs-lint": "npm-run-all docs-eslint docs-prettier-check docs-typecheck docs-vnu",
    "docs-eslint": "eslint --cache --cache-location .cache/.eslintcache --ext .js,.mjs,.cjs algolia build site",
    "docs-typecheck": "astro check --root site",
    "docs-prettier-check": "prettier --check --cache .",
    "docs-prettier-format": "prettier --write --cache .",
    "docs-serve": "astro dev --root site --port 9001",
    "docs-serve-only": "npx sirv-cli _site --port 9001",
    "astro-dev": "astro dev --root site --port 9001",
    "astro-build": "astro build --root site && rm -rf _site && cp -r site/dist _site",
    "astro-preview": "astro preview --root site --port 9001"
  },
  "author": "Dhruv Techapps",
  "license": "Apache-2.0",
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/markdown-remark": "^7.1.0",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/prism": "^4.0.1",
    "@astrojs/sitemap": "^3.7.2",
    "@docsearch/js": "3.9.0",
    "@stackblitz/sdk": "^1.11.0",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.2.0",
    "@types/prismjs": "^1.26.6",
    "astro": "^7.1.3",
    "astro-auto-import": "^0.5.2",
    "autoprefixer": "^10.5.0",
    "bootstrap": "^5.3.8",
    "clipboard": "^2.0.11",
    "eslint": "8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "56.0.1",
    "github-slugger": "^2.0.0",
    "htmlparser2": "^12.0.0",
    "image-size": "^2.0.2",
    "js-yaml": "^4.3.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mdast-util-to-string": "^4.0.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prismjs": "^1.30.0",
    "rehype-autolink-headings": "^7.1.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sass": "1.78.0",
    "sass-true": "^10.1.0",
    "typescript": "5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vnu-jar": "26.2.1",
    "zod": "^4.3.6"
  }
}
