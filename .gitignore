# Build output
/_site/
/site/dist/
/site/.astro/

# Written on every build and dev start by the `bootstrap()` integration in site/astro.config.ts:
# `copyStatic()` copies site/static/** here with `[version]` renamed to the docs version,
# `copyBootstrap()` adds Bootstrap's dist/ from node_modules, and `aliasStatic()` writes
# /apple-touch-icon.png and /favicon.ico. Author assets in site/static, not here.
/site/public/

# Dependencies
node_modules/

# Cache
/.prettiercache
/site/.prettiercache

# Hugo legacy files (kept as archive)
/resources/
/.hugo_build.lock

# Numerous always-ignore extensions
*.diff
*.err
*.log
*.orig
*.rej
*.swo
*.swp
*.vi
*.zip
*~

# OS or Editor folders
._*
.cache
.DS_Store
.idea
.project
.settings
.tmproj
*.esproj
*.sublime-project
*.sublime-workspace
nbproject
Thumbs.db
/.vscode/
# Local Netlify folder
.netlify

# Komodo
.komodotools
*.komodoproject

# Folders to ignore
/dist-sass/
/js/coverage/
/node_modules/
